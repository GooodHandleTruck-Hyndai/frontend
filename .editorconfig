# 팀 공통 코드 스타일. Android Studio와 ktlint가 둘 다 이 파일을 읽어요.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = android_studio
max_line_length = 120
# Compose 함수는 대문자로 시작하니까 함수 이름 규칙에서 예외
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
